# Atoms Demo 全部环境变量；复制为 .env 后按需填写。严禁提交真实密钥。

# ---- 认证 ----
# dev：免登录（DEV_USER 即当前用户）；oidc：走 AuthSphere
AUTH_MODE=dev
DEV_USER=dev-user
PORT=4173
WORKSPACE_DIR=/workspace
OIDC_ISSUER=https://auth.ss-vip.cn
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 线上应为 https://atoms.ss-vip.cn/api/auth/callback
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/callback
OIDC_INSECURE_COOKIES=0
OIDC_SKIP_ISSUER_CHECK=0

# ---- Postgres 事实源（可选）----
# 留空则用文件存储；设置后会话/事件落 atoms 库
DATABASE_DSN=

# ---- Redis Streams 实时扇出 + 任务队列（可选，ADR-0007）----
# 来自 atoms-middleware Secret；留空则退回单进程 MemoryBus + 有界 MemoryQueue。
# 配置 Redis 后队列不可用（满/断连）时入队返回 503，不静默回退内存队列。
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Worker 池大小 = LLM 并发闸门；内存队列容量为其 ×4
QUEUE_WORKERS=3

# ---- 腾讯云 COS 构建产物（可选，T9）----
# 全部留空 = /app 继续读本地 workspace/dist。
# 任一 COS 配置出现时，Bucket/Endpoint/SecretID/SecretKey 必须齐全，避免静默回退；
# SESSION_TOKEN 仅临时密钥需要，正式上线应换 CAM 子账号永久密钥（最小权限：仅此 bucket）。
# 生产值由 atoms-demo-env Secret 注入，禁止写入仓库或 .env。
COS_BUCKET=
COS_ENDPOINT=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=

# ---- 生成引擎兜底链：DeepSeek → 本地 gemma → 模板 ----
# 留空则自动降级到本地模型/模板
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
LOCAL_LLM_BASE_URL=http://192.168.1.101:8090/v1
LOCAL_LLM_MODEL=

# ---- 本地 compose ----
# web 对外端口：http://localhost:${WEB_PORT}
WEB_PORT=8080
