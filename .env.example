# Atoms Demo 全部环境变量；复制为 .env 后按需填写。严禁提交真实密钥。

# ---- 服务 ----
PORT=4173
WORKSPACE_DIR=/workspace

# ---- Postgres 事实源 ----
# Compose 留空时使用内置的本地 Postgres；独立运行 server 时填实际 DSN。
DATABASE_DSN=
# 仅可信反代的来源 CIDR（逗号分隔）；生产须按实际 Nginx/入口网段配置。
# 默认空值，忽略所有客户端 IP 头，只按直连对端计数；勿信任整个私网。
TRUSTED_PROXY_CIDRS=
# 邮件中的平台地址；生产用公开 HTTPS 域名，本地 HTTP 时 COOKIE_SECURE=0。
APP_BASE_URL=http://localhost:4173
COOKIE_SECURE=1
# 受控的平台管理员邮箱，逗号分隔；需正常注册并验证，不赋予项目内容访问权。
PLATFORM_ADMIN_EMAILS=

# ---- 账户邮件（SMTP）----
# Compose 留空时使用 Mailpit 捕获邮件（http://localhost:8025）。
# 生产 163 邮箱：SMTP_HOST=smtp.163.com、SMTP_PORT=465、SMTP_SECURITY=tls；
# SMTP_USERNAME / SMTP_FROM 使用发件邮箱，SMTP_PASSWORD 使用轮换后的授权码，
# 仅通过部署 Secret 注入，绝不提交真实值。其他服务商可用 starttls/587。
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Redis Streams 实时扇出 + 任务队列（可选，ADR-0007）----
# 来自 atoms-middleware Secret；留空则退回单进程 MemoryBus + 有界 MemoryQueue。
# 配置 Redis 后队列不可用（满/断连）时入队返回 503，不静默回退内存队列。
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Worker 池大小 = LLM 并发闸门；内存队列容量为其 ×4
QUEUE_WORKERS=3

# ---- 腾讯云 COS 构建产物（可选，T9）----
# 全部留空 = /app 继续读本地 workspace/dist。
# 任一 COS 配置出现时，Bucket/Endpoint/SecretID/SecretKey 必须齐全，避免静默回退；
# SESSION_TOKEN 仅临时密钥需要，正式上线应换 CAM 子账号永久密钥（最小权限：仅此 bucket）。
# 生产值由 atoms-demo-env Secret 注入，禁止写入仓库或 .env。
COS_BUCKET=
COS_ENDPOINT=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=

# ---- 生成引擎：DeepSeek → Kimi → 本地 gemma ----
# 只使用真实模型；全部不可用或生成失败时，回合显式报错，不回退到模板。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_MODEL=
LOCAL_LLM_BASE_URL=http://192.168.1.101:8090/v1
LOCAL_LLM_MODEL=

# ---- 本地 compose ----
# web 对外端口：http://localhost:${WEB_PORT}
WEB_PORT=8080
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
