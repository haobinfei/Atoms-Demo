# ---- build stage ----
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# esbuild ships platform binaries via Go modules, so a pure-static build
# (CGO off) still bundles and runs the compiler inside the image.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server

# ---- runtime: minimal static base, CA certs included, non-root user ----
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/server /server
USER nonroot
EXPOSE 4173
VOLUME ["/workspace"]
ENV PORT=4173 \
    WORKSPACE_DIR=/workspace \
    AUTH_MODE=dev
ENTRYPOINT ["/server"]
