# ---- build stage: tsc typecheck + vite production build ----
# node:24-alpine 为 ss-vip 命名空间已确认的镜像（vite 6 构建无需 Node 26）
FROM registry.cn-hangzhou.aliyuncs.com/ss-vip/node:24-alpine AS build
WORKDIR /src
COPY web/package.json web/package-lock.json ./
# 集群出网到 registry.npmjs.org 的 tarball 链路不通，统一走 npmmirror；
# lockfile 里的 resolved 域名需一并替换，否则 npm ci 仍按 npmjs 拉包
RUN npm config set registry https://registry.npmmirror.com \
 && sed -i 's#https://registry.npmjs.org#https://registry.npmmirror.com#g' package-lock.json \
 && npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

# ---- runtime: nginx serves the SPA and reverse-proxies the backend ----
FROM registry.cn-hangzhou.aliyuncs.com/ss-vip/nginx:alpine
# Default upstream for docker compose; Kubernetes overrides this with the
# cluster service DNS via the Helm deployment's env.
ENV ATMOS_SERVER=server:4173
COPY web/nginx-default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
